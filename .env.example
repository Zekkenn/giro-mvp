# =============================================================================
# Giro Agent - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_ENV=development
APP_NAME=giro-agent
PORT=8000
DEBUG=True

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=giro_agent
POSTGRES_USER=giro
POSTGRES_PASSWORD=giro_dev_password

# Database URL (constructed from above or override directly)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# -----------------------------------------------------------------------------
# AWS Configuration (Bedrock & S3)
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# AWS Bedrock
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_KB_ID=your_knowledge_base_id_here

# AWS S3 (for knowledge source storage)
S3_BUCKET_NAME=giro-agent-knowledge-sources
S3_REGION=us-east-1

# AWS OpenSearch (if using for vector store)
OPENSEARCH_ENDPOINT=your_opensearch_endpoint_here

# -----------------------------------------------------------------------------
# OpenAI Configuration (for demo/fallback)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Authentication (OAuth - to be configured)
# -----------------------------------------------------------------------------
# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Microsoft OAuth
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret

# OAuth Redirect URI
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# Session Secret
SECRET_KEY=your_secret_key_here_change_in_production

# -----------------------------------------------------------------------------
# PgAdmin (Database Management UI)
# -----------------------------------------------------------------------------
PGADMIN_EMAIL=admin@giro.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# CORS (for API)
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_ANALYTICS=False
ENABLE_TELEMETRY=False
ENABLE_LEARNING_STYLE_DETECTION=True
ENABLE_AI_SUMMARY_GENERATION=True
